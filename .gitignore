# Secrets & credentials
.env
.env.ai
*.key
*.pem
*.p12
*.pfx
.keys/

# Terraform state & plans (sensitive infra state)
**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.backup
terraform/**/*.tfvars
terraform/**/backup-state/
