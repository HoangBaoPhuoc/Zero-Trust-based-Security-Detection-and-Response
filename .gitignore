# Secrets & credentials
.env
.env.ai
*.key
*.pem
*.p12
*.pfx
.keys/

# Terraform state & plans (sensitive infra state)
**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.backup
terraform/**/*.tfvars
terraform/**/backup-state/
terraform/**/tfplan*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Runtime artifacts
logs/
results/
models/*.pkl
models/*.keras
models/*.npy

# Accidentally created directory
~/

# istioctl auto-downloaded by scripts/deploy-app.sh (deploy_istio) if not
# already on PATH — pinned version, not project source
.istio-*/
