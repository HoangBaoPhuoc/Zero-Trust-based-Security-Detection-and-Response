# Secrets & credentials
.env
.env.ai
*.key
*.pem
*.p12
*.pfx
.keys/
# A3 device CA: private key + issued device certs/p12 are regenerated locally
# (or restored from Vault, see scripts/deploy-security-stack.sh::provision_device_ca)
# — never meant to live in git, per that function's own comment.
deploy/vendor/device-ca/

# Terraform state & plans (sensitive infra state)
**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.backup
terraform/**/*.tfvars
terraform/**/backup-state/
terraform/**/tfplan*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Runtime artifacts
logs/
results/
tests/runs.jsonl
models/*.pkl
models/*.keras
models/*.npy

# Accidentally created directory
~/

# istioctl auto-downloaded by scripts/deploy-app.sh (deploy_istio) if not
# already on PATH — pinned version, not project source
.istio-*/
