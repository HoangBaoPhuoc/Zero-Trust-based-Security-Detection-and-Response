{
  "realm": "ztlab",
  "enabled": true,
  "displayName": "ZTLab",
  "sslRequired": "external",
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 20,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "clients": [
    {
      "clientId": "aws-console-sso",
      "protocol": "saml",
      "attributes": {
        "saml.assertion.signature": "true",
        "saml_name_id_format": "email",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#"
      },
      "redirectUris": [
        "https://signin.aws.amazon.com/saml"
      ],
      "protocolMappers": [
        {
          "name": "role-list",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "config": {
            "single": "false",
            "attribute.nameformat": "Basic",
            "attribute.name": "https://aws.amazon.com/SAML/Attributes/Role"
          }
        }
      ]
    },
    {
      "clientId": "siem-backend",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "crapi-bff",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://crapi.ztlab.local/*",
        "http://crapi.ztlab.local:8080/*",
        "http://localhost:8080/*",
        "http://localhost:18081/*",
        "http://127.0.0.1:8080/*",
        "http://127.0.0.1:18081/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "aud-crapi-bff",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "crapi-bff",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "crapi-bff-stepup",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://crapi.ztlab.local/*",
        "http://crapi.ztlab.local:8080/*",
        "http://localhost:8080/*",
        "http://localhost:18081/*",
        "http://127.0.0.1:8080/*",
        "http://127.0.0.1:18081/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "aud-crapi-bff",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "crapi-bff",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "crapi-user",
        "description": "crAPI: người dùng thường (đọc + hành động cơ bản)"
      },
      {
        "name": "crapi-mechanic",
        "description": "crAPI: thợ máy (mechanic endpoints)"
      },
      {
        "name": "crapi-admin",
        "description": "crAPI: quản trị (admin/management endpoints)"
      },
      {
        "name": "soc-analyst",
        "description": "SOC analyst: chỉ đọc, xem log/alert"
      }
    ]
  },
