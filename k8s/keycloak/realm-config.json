{
  "realm": "ztlab",
  "enabled": true,
  "displayName": "ZTLab",
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "api-gateway",
      "protocol": "openid-connect",
      "publicClient": false,
      "authorizationServicesEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://api.ztlab.local/*", "https://api-gateway.ztlab.local/*"],
      "webOrigins": ["+"]
    },
    {
      "clientId": "web-portal",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://portal.ztlab.local/*",
        "http://portal.ztlab.local:8080/*",
        "http://localhost:8080/*",
        "http://localhost:5000/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "siem-backend",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "roles": {
    "realm": [
      { "name": "financial-read" },
      { "name": "financial-write" },
      { "name": "security-analyst" },
      { "name": "security-admin" }
    ]
  },
  "users": [
    {
      "username": "testuser01",
      "email": "testuser01@ztlab.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "Test1234!", "temporary": false }
      ],
      "realmRoles": ["financial-read", "financial-write"]
    },
    {
      "username": "merchant01",
      "email": "merchant01@ztlab.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "Merchant1234!", "temporary": false }
      ],
      "realmRoles": ["financial-read"]
    },
    {
      "username": "analyst01",
      "email": "analyst01@ztlab.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "Analyst1234!", "temporary": false }
      ],
      "realmRoles": ["security-analyst"]
    }
  ]
}
