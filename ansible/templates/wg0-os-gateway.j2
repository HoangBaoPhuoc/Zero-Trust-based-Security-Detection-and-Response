# WireGuard Configuration for OpenStack Gateway (VPN Client)
# Generated by Ansible for os_gateway
# Interface Address: {{ gateway_ip }}/24
# Peer Endpoint: {{ peer_endpoint }}

[Interface]
Address = {{ gateway_ip }}/24
PrivateKey = {{ wg_private_key }}

# Enable IP forwarding and masquerading for inter-cloud traffic
PostUp   = iptables -A FORWARD -i {{ wg_interface }} -j ACCEPT; iptables -A FORWARD -o {{ wg_interface }} -j ACCEPT; iptables -t nat -A POSTROUTING -o {{ primary_interface }} -j MASQUERADE
PostDown = iptables -D FORWARD -i {{ wg_interface }} -j ACCEPT; iptables -D FORWARD -o {{ wg_interface }} -j ACCEPT; iptables -t nat -D POSTROUTING -o {{ primary_interface }} -j MASQUERADE

# AWS Gateway Peer (has public IP, acts as endpoint)
[Peer]
PublicKey = {{ peer_public_key }}
Endpoint = {{ peer_endpoint }}
AllowedIPs = 10.200.200.0/24, 10.10.1.0/24, 10.10.2.0/24, 10.10.3.0/24, 10.42.0.0/16, 10.43.0.0/16
PersistentKeepalive = 25
