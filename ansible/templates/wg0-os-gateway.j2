# WireGuard Configuration for OpenStack Gateway (VPN Client)
# Generated by Ansible for os_gateway
# Interface Address: {{ gateway_ip }}/24
# Peer Endpoint: {{ peer_endpoint }}

[Interface]
Address = {{ gateway_ip }}/24
PrivateKey = {{ wg_private_key }}

# Enable IP forwarding, masquerading, and stable AWS-to-OpenStack core NodePort routing.
# SNAT is required because both clusters use overlapping pod CIDRs; without it OS nodes may route replies locally.
PostUp   = iptables -A FORWARD -i {{ wg_interface }} -j ACCEPT; iptables -A FORWARD -o {{ wg_interface }} -j ACCEPT; iptables -t nat -A POSTROUTING -o {{ primary_interface }} -j MASQUERADE; iptables -t nat -A POSTROUTING -o ens4 -j MASQUERADE; iptables -t nat -A POSTROUTING -o ens5 -j MASQUERADE; iptables -t nat -A PREROUTING -i {{ wg_interface }} -p tcp --dport 30080 -j DNAT --to-destination 192.168.101.11:30080; iptables -t nat -A POSTROUTING -o ens4 -p tcp -d 192.168.101.11 --dport 30080 -j SNAT --to-source 192.168.101.1; iptables -A FORWARD -i {{ wg_interface }} -o ens4 -p tcp -d 192.168.101.11 --dport 30080 -j ACCEPT
PostDown = iptables -D FORWARD -i {{ wg_interface }} -j ACCEPT; iptables -D FORWARD -o {{ wg_interface }} -j ACCEPT; iptables -t nat -D POSTROUTING -o {{ primary_interface }} -j MASQUERADE; iptables -t nat -D POSTROUTING -o ens4 -j MASQUERADE; iptables -t nat -D POSTROUTING -o ens5 -j MASQUERADE; iptables -t nat -D PREROUTING -i {{ wg_interface }} -p tcp --dport 30080 -j DNAT --to-destination 192.168.101.11:30080; iptables -t nat -D POSTROUTING -o ens4 -p tcp -d 192.168.101.11 --dport 30080 -j SNAT --to-source 192.168.101.1; iptables -D FORWARD -i {{ wg_interface }} -o ens4 -p tcp -d 192.168.101.11 --dport 30080 -j ACCEPT

# AWS Gateway Peer (has public IP, acts as endpoint)
[Peer]
PublicKey = {{ peer_public_key }}
Endpoint = {{ peer_endpoint }}
AllowedIPs = 10.200.200.0/24, 10.10.1.0/24, 10.10.2.0/24, 10.10.3.0/24, 10.42.0.0/16, 10.43.0.0/16
PersistentKeepalive = 25
