+          # Starting Istio SDS Server" (rơi về cert tự ký của istiod, KHÔNG
+          # phải SPIRE) dù có podAnnotations. Dùng k8s.overlays (strategic
+          # patch vào chính Deployment) để mount đúng socket path.
+          podAnnotations:
+            spiffe.io/spiffeid: "spiffe://ztlab.local/aws/edge-gateway"
+          overlays:
