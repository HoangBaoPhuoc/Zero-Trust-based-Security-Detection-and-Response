diff --git a/k8s/crapi/waf.yaml b/k8s/crapi/waf.yaml
index 6b553911..01ce8eae 100644
--- a/k8s/crapi/waf.yaml
+++ b/k8s/crapi/waf.yaml
@@ -25,11 +25,53 @@
 # fails closed with no decision even logged, since the request never carries a
 # principal at all. `waf-proxy-backend-conf` below overrides just that one
 # nginx include to use `$proxy_host` (nginx's own proxy_pass target) instead.
+#
+# Second bug, same root cause, found live 2026-09-13 on the first real login
+# through the new Istio Gateway (Phần 1.3): with Host rewritten to
+# `$proxy_host`, BFF's `_external_base()` (services/bff/main.py) — used to
+# build the OIDC `redirect_uri` and the `/kc/...` authorization URL — saw Host
+# = `bff.crapi.svc.cluster.local:8080` and built an unreachable-from-outside
+# redirect, instead of the real edge host (`crapi.ztlab.local:18444`). Fixed
+# by also sending `X-Forwarded-Host` with the ORIGINAL client Host —
+# `_external_base()` already prefers that header over plain `Host` for
+# exactly this reason, so this needed nginx to actually send it. Uses
+# `$http_host` (raw Host header, keeps a client-sent port) not nginx's `$host`
+# variable (silently drops the port) — the gateway is reached on a non-default
+# port (:18444) so a dropped port breaks the redirect just as badly.
 ---
 apiVersion: v1
 kind: ServiceAccount
 metadata: { name: waf, namespace: crapi }
 ---
+# Found live 2026-09-13 running the thesis's BOLA/CRS control measurement
+# (tests/crapi_bola.sh — expects CRS to record ZERO hits on a pure
+# authorization-bypass request, since it carries no injection payload): CRS
+# rule 921140 ("HTTP Header Injection Attack via headers") false-positived on
+# EVERY request through the new Istio Gateway (Phần 1.3), not on anything
+# BOLA-specific. Cause: Envoy's `x-forwarded-client-cert` header carries the
+# client's PEM certificate URL-encoded (`%0A` for each newline); CRS's own
+# `t:urlDecodeUni` transform decodes it back to real `\n` bytes before
+# matching, and rule 921140 flags any raw `[\n\r]` in a header value as CRLF
+# injection — a real PEM certificate legitimately contains dozens. This is a
+# mesh-infrastructure artifact appearing on 100% of requests once the mTLS
+# Gateway started populating XFCC with real cert data, not a WAF weakness or
+# a BOLA-request property, so scope the exclusion to exactly that one
+# rule+header (every other header, and every other 921xxx CRLF check on this
+# one, stays fully active).
+apiVersion: v1
+kind: ConfigMap
+metadata: { name: waf-crs-exclusions, namespace: crapi }
+data:
+  # This image's setup.conf includes owasp-crs/rules/*.conf as ONE flat glob
+  # (confirmed live: no separate before/after phase) — alphabetical order
