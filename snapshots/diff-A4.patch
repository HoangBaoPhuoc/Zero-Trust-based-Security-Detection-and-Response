+    "credential_stuffing": "T1110.004",
+    "jwt_replay": "T1550.001",
+    "lateral_movement": "T1021.007",
+    "account_manipulation": "T1098",
+    "large_response": "T1041",
+    "data_staging": "T1074",
+    "cryptomining": "T1496",
+    "container_escape": "T1611",
+    "impair_defenses": "T1562",
