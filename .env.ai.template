# AI Log Analyzer
# Copy to .env.ai for Docker Compose. Keep real API keys out of Git.
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_ANALYZER_POLL_ENABLED=true
AI_ANALYZER_POLL_INTERVAL_SECONDS=30
AI_ANALYZER_LOOKBACK_SECONDS=90
AI_ANALYZER_MAX_LOGS_PER_BATCH=25
AI_ANALYZER_MIN_ALERT_SEVERITY=medium
AI_ANALYZER_LOKI_QUERY={job=~"envoy|opa|system"}

# SOAR Engine
SOAR_DRY_RUN=true
SOAR_AUTO_EXECUTE=true
SOAR_MIN_SEVERITY=high
SOAR_MIN_CONFIDENCE=0.70
SOAR_NAMESPACE=financial
SOAR_ALLOWED_CONTEXTS=ctx-aws,ctx-openstack
SOAR_API_TOKEN=
SOAR_CASE_STORE_PATH=/data/cases.jsonl
