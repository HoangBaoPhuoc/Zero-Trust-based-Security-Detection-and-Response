        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "OPA quyết định (allow / deny) — cả 2 cluster",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (opa_result) (count_over_time({job=\"opa-decisions\"} | json [1m]))",
          "refId": "A",
          "legendFormat": "result={{opa_result}}"
        }
      ]
    },
    {
