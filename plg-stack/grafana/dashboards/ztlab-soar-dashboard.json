{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "ZTLab SOAR Dashboard — Anomaly Detection, IP Blocks, Security Alerts, Playbook Actions",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 300,
      "title": "🔴 Anomaly Score & Threat Level",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Điểm bất thường tổng hợp — đỏ = nguy hiểm cao",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 75 }
            ]
          },
          "mappings": [],
          "unit": "none",
          "min": 0, "max": 100
        }
      },
      "gridPos": { "h": 7, "w": 5, "x": 0, "y": 1 },
      "id": 301,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "text": {}
      },
      "title": "Anomaly Score (15min)",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "ztlab_anomaly_score",
          "legendFormat": "Score",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Lịch sử anomaly score theo thời gian",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 40 },
              { "color": "red", "value": 70 }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false
          }
        }
      },
      "gridPos": { "h": 7, "w": 11, "x": 5, "y": 1 },
      "id": 302,
      "options": {
        "legend": { "calcs": ["last", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Anomaly Score History",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "ztlab_anomaly_score",
          "legendFormat": "Anomaly Score",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Tổng số giao dịch bị fraud block",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 3, "w": 8, "x": 16, "y": 1 },
      "id": 303,
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "title": "Fraud Blocks (tổng)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(ztlab_transactions_total{status=\"blocked_fraud\"}[24h]))",
          "legendFormat": "Fraud Blocked",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Tỉ lệ xác thực thất bại",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 3, "w": 8, "x": 16, "y": 4 },
      "id": 304,
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "title": "Auth Failures (24h)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(ztlab_auth_failures_total[24h]))",
          "legendFormat": "Auth Failures",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 310,
      "title": "🚨 Active Alerts & Security Events",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "description": "Real-time security alerts — fraud, blocks, denied, attacks detected",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 9 },
      "id": 311,
      "options": {
        "dedupStrategy": "signature",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "🔴 Security Alert Logs (live)",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{namespace=~\"financial|plg-stack\"} |~ \"(?i)(fraud_gate_bypass|payment_blocked|ip_blocked|brute_force|lateral_movement|port_scan|exploit_probe|credential_stuffing|soar_action|blocked_fraud|email_sent)\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 320,
      "title": "🤖 SOAR Actions & Playbooks",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "description": "SOAR engine tự động phản ứng với các cuộc tấn công",
      "gridPos": { "h": 12, "w": 14, "x": 0, "y": 22 },
      "id": 321,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "🤖 SOAR Playbook Execution Log",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{app=\"soar-engine\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "description": "AI Analyzer phát hiện patterns trong logs",
      "gridPos": { "h": 12, "w": 10, "x": 14, "y": 22 },
      "id": 322,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "🧠 AI Analyzer Detections",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{app=\"soar-engine\"} |~ \"(?i)(alert|attack|block|detect|anomaly|playbook)\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 330,
      "title": "📊 Transaction & Fraud Stats",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Giao dịch theo trạng thái",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 331,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Transaction Rate by Status",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (status) (rate(ztlab_transactions_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Auth failure rate theo lý do",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 332,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Auth Failure Rate by Reason",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (reason) (rate(ztlab_auth_failures_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 340,
      "title": "🔐 Zero Trust Controls",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "description": "OPA policy decisions — allow/deny",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 44 },
      "id": 341,
      "options": {
        "dedupStrategy": "signature",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "title": "🔏 OPA Authorization Decisions",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{app=\"api-gateway\"} |~ \"(?i)(authz|opa|denied|permitted|401|403|jwks|jwt)\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "description": "SPIRE mTLS — SVID validation, cert rotation",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 44 },
      "id": 342,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "title": "🔑 SPIRE/mTLS Events",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{namespace=\"spire\"} | {app=\"core-banking\"} |~ \"(?i)(svid|spiffe|mtls|cert|rotation)\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["ztlab", "soar", "security"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ZTLab SOAR Dashboard",
  "uid": "ztlab-soar",
  "version": 1
}
