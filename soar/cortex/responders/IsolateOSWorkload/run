import os
import json

class Responder:
    def __init__(self):
        self.os_auth_url = "http://192.168.1.254:5000/v3"
        self.os_project = "ZTA-SIEM-SOAR"

    def run(self):
        result = {
            "status": "ok",
            "action": "isolate_openstack_workload",
            "os_auth_url": self.os_auth_url,
            "os_project": self.os_project,
            "note": "TODO: implement Neutron SG + K3s NetworkPolicy + OPA deny push"
        }
        print(json.dumps(result))

if __name__ == "__main__":
    Responder().run()
